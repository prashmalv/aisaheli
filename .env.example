# Copy this file to `.env` and fill in your Azure OpenAI API key.
# Without a key, AI Saheli automatically falls back to curated scripted
# responses so the demo still works offline.

# Azure OpenAI (v1 API surface — compatible with the OpenAI SDK)
AZURE_OPENAI_ENDPOINT=https://egov-poc-proj-two-rjt-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# Deployment (model) name as shown in Azure AI Foundry / Azure OpenAI Studio
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Voice — Azure Speech (neural TTS). The AIServices resource includes Speech,
# so the same key/region work. AZURE_SPEECH_KEY defaults to AZURE_OPENAI_API_KEY.
AZURE_SPEECH_REGION=eastus2
AZURE_SPEECH_KEY=

# Port the Express server listens on (also serves the built frontend in prod).
PORT=3001
