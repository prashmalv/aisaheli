{
  "name": "ai-saheli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Saheli — multilingual citizen AI assistant for the Ministry of Women & Child Development (Poshan, Vatsalya, Mission Shakti demo)",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "serve": "npm run build && npm start"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "openai": "^6.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.0.0",
    "vite": "^7.0.0"
  }
}
